# BACKEND OWNER ONLY. Teammates do not need this file or Neon accounts.
# Normal ./start.ps1 uses the public URL in shared-backend.json.
# Put real database settings only on the hosted server or owner's machine.
FINAPP_DATABASE_MODE=shared
# For owner-only local server work, supply ALL THREE settings together:
# SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_DIRECT_HOST/finapp?sslmode=require
# SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_ROLE
# SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

# Explicit offline development: FINAPP_DATABASE_MODE=local
# Local mode does NOT synchronize accounts across computers.
FINAPP_POSTGRES_VOLUME=finapp_postgres_data

# Optional; not required for authentication or simulations.
ANTHROPIC_API_KEY=
